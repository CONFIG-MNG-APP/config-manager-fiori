{
  "_version": "1.48.0",
  "sap.app": {
    "id": "zcapstone.configmmroute",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.21.0",
      "toolsId": "9ea86f21-fdb9-4b45-8b40-e2a6abff1a82"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/iwbep/all/srvd/sap/zsd_mm_route_conf/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "MMRoute-review": {
          "semanticObject": "MMRoute",
          "action": "review",
          "title": "MM Route Compare",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "flexBundle": false,
    "dependencies": {
      "minUI5Version": "1.108.33",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zcapstone.configmmroute.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "MMRouteConfList",
          "target": "MMRouteConfList"
        },
        {
          "pattern": "MMRouteConf({key}):?query:",
          "name": "MMRouteConfObjectPage",
          "target": "MMRouteConfObjectPage"
        }
      ],
      "targets": {
        "MMRouteConfList": {
          "type": "Component",
          "id": "MMRouteConfList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/MMRouteConf",
              "variantManagement": "None",
              "controllerExtensions": {
                "zcapstone.configmmroute.ext.controller.ListReportExt": {}
              },
              "navigation": {
                "MMRouteConf": {
                  "detail": {
                    "route": "MMRouteConfObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                },
                "@com.sap.vocabularies.UI.v1.SelectionFields": {
                  "filterFields": {
                    "ReqId": {
                      "label": "Request ID",
                      "availability": "Hidden"
                    },
                    "ConfId": {
                      "label": "Config ID",
                      "availability": "Hidden"
                    }
                  }
                }
              },
              "initialLoad": false
            }
          }
        },
        "MMRouteConfObjectPage": {
          "type": "Component",
          "id": "MMRouteConfObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/MMRouteConf",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.Facets": {
                  "sections": {
                    "CustomCompareSection": {
                      "title": "Detailed Comparison",
                      "template": "zcapstone.configmmroute.ext.fragment.CompareTable",
                      "position": {
                        "placement": "Before",
                        "anchor": "MetaInfo"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
