{
  "_version": "1.48.0",
  "sap.app": {
    "id": "zcaption.configfilimit",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [""],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.21.0",
      "toolsId": "b6bd4769-7244-4044-a163-721814a9e6ab"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/iwbep/all/srvd/sap/zsd_fi_limit_conf/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "FILimit-review": {
          "semanticObject": "FILimit",
          "action": "review",
          "title": "FI Limit Compare",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.108.33",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zcaption.configfilimit.i18n.i18n",
          "supportedLocales": [""],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "type": "sap.ui.model.odata.v4.ODataModel",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleUrl": "i18n/i18n.properties",
          "supportedLocales": [""],
          "fallbackLocale": ""
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "FILimitConfList",
          "target": "FILimitConfList"
        },
        {
          "pattern": "FILimitConf({key}):?query:",
          "name": "FILimitConfObjectPage",
          "target": "FILimitConfObjectPage"
        }
      ],
      "targets": {
        "FILimitConfList": {
          "type": "Component",
          "id": "FILimitConfList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/FILimitConf",
              "variantManagement": "None",
              "navigation": {
                "FILimitConf": {
                  "detail": {
                    "route": "FILimitConfObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.SelectionFields": {
                  "filterFields": {
                    "ReqId": {
                      "label": "Request ID",
                      "availability": "Hidden"
                    },
                    "ConfId": {
                      "label": "Config ID",
                      "availability": "Hidden"
                    }
                  }
                }
              },
              "initialLoad": false
            }
          }
        },
        "FILimitConfObjectPage": {
          "type": "Component",
          "id": "FILimitConfObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/FILimitConf",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.Facets": {
                  "sections": {
                    "CurrentValues": {
                      "visible": false
                    },
                    "OldValues": {
                      "visible": false
                    },
                    "AdminInfo": {
                      "visible": false
                    },
                    "CompareTableSection": {
                      "template": "zcaption.configfilimit.ext.fragment.CompareTable",
                      "title": "Config Comparison",
                      "position": {
                        "placement": "Before",
                        "anchor": "MetaInfo"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
