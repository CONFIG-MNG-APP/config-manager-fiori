<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Table id="idCompareTable">
        <columns>
            <Column id="idColField">
                <Text id="idTxtField" text="Configuration Field" />
            </Column>
            <Column id="idColBefore">
                <Text id="idTxtBefore" text="Current Value (Before)" />
            </Column>
            <Column id="idColAfter">
                <Text id="idTxtAfter" text="Proposed Value (After)" />
            </Column>
            <Column id="idColStatus" width="10%">
                <Text id="idTxtStatus" text="Change Status" />
            </Column>
        </columns>
        <items>
            <!-- EnvId -->
            <ColumnListItem id="idItemEnvId">
                <cells>
                    <Text id="idTxtLblEnvId" text="Environment" />
                    <ObjectStatus id="idStatOldEnvId" text="{OldEnvId}" state="{= ${EnvId} !== ${OldEnvId} ? 'Error' : 'None' }"/>
                    <ObjectStatus id="idStatNewEnvId" text="{EnvId}" state="{= ${EnvId} !== ${OldEnvId} ? 'Success' : 'None' }"/>
                    <core:Icon id="idIconEnvId" 
                               src="{= ${EnvId} !== ${OldEnvId} ? 'sap-icon://edit' : 'sap-icon://accept' }" 
                               color="{= ${EnvId} !== ${OldEnvId} ? '#bb0000' : '#107e3e' }" />
                </cells>
            </ColumnListItem>

            <!-- ExpenseType -->
            <ColumnListItem id="idItemExpType">
                <cells>
                    <Text id="idTxtLblExpType" text="Expense Type" />
                    <ObjectStatus id="idStatOldExpType" text="{OldExpenseType}" state="{= ${ExpenseType} !== ${OldExpenseType} ? 'Error' : 'None' }"/>
                    <ObjectStatus id="idStatNewExpType" text="{ExpenseType}" state="{= ${ExpenseType} !== ${OldExpenseType} ? 'Success' : 'None' }"/>
                    <core:Icon id="idIconExpType" 
                               src="{= ${ExpenseType} !== ${OldExpenseType} ? 'sap-icon://edit' : 'sap-icon://accept' }" 
                               color="{= ${ExpenseType} !== ${OldExpenseType} ? '#bb0000' : '#107e3e' }" />
                </cells>
            </ColumnListItem>

            <!-- GlAccount -->
            <ColumnListItem id="idItemGlAcc">
                <cells>
                    <Text id="idTxtLblGlAcc" text="G/L Account" />
                    <ObjectStatus id="idStatOldGlAcc" text="{OldGlAccount}" state="{= ${GlAccount} !== ${OldGlAccount} ? 'Error' : 'None' }"/>
                    <ObjectStatus id="idStatNewGlAcc" text="{GlAccount}" state="{= ${GlAccount} !== ${OldGlAccount} ? 'Success' : 'None' }"/>
                    <core:Icon id="idIconGlAcc" 
                               src="{= ${GlAccount} !== ${OldGlAccount} ? 'sap-icon://edit' : 'sap-icon://accept' }" 
                               color="{= ${GlAccount} !== ${OldGlAccount} ? '#bb0000' : '#107e3e' }" />
                </cells>
            </ColumnListItem>

            <!-- AutoApprLim & Currency -->
            <ColumnListItem id="idItemAmount">
                <cells>
                    <Text id="idTxtLblAmount" text="Auto Approval Limit" />
                    <ObjectStatus id="idStatOldAmount" text="{OldAutoApprLim} {OldCurrency}" state="{= ${AutoApprLim} !== ${OldAutoApprLim} || ${Currency} !== ${OldCurrency} ? 'Error' : 'None' }"/>
                    <ObjectStatus id="idStatNewAmount" text="{AutoApprLim} {Currency}" state="{= ${AutoApprLim} !== ${OldAutoApprLim} || ${Currency} !== ${OldCurrency} ? 'Success' : 'None' }"/>
                    <core:Icon id="idIconAmount" 
                               src="{= ${AutoApprLim} !== ${OldAutoApprLim} || ${Currency} !== ${OldCurrency} ? 'sap-icon://edit' : 'sap-icon://accept' }" 
                               color="{= ${AutoApprLim} !== ${OldAutoApprLim} || ${Currency} !== ${OldCurrency} ? '#bb0000' : '#107e3e' }" />
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</core:FragmentDefinition>
