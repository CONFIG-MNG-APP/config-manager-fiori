        text="{ModuleId}"
        state="{= ${path: 'ModuleId', targetType: 'any'} === 'FI' ? 'Information' : ${path: 'ModuleId', targetType: 'any'} === 'MM' ? 'Warning' : ${path: 'ModuleId', targetType: 'any'} === 'SD' ? 'Success' : 'None' }"
