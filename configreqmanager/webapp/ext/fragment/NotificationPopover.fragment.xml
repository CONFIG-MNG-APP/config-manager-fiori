<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <ResponsivePopover
        id="notificationPopover"
        title="Notifications ({notification>/unreadCount} unread)"
        placement="Bottom"
        contentWidth="400px"
        contentHeight="380px">

        <content>
            <List
                id="notifList"
                items="{notification>/notifications}"
                noDataText="No new notifications"
                mode="None">

                <StandardListItem
                    id="notifListItem"
                    title="{notification>title}"
                    description="{notification>description}"
                    info="{notification>timeDisplay}"
                    infoState="Warning"
                    type="Active"
                    highlight="{= ${notification>read} ? 'None' : 'Information' }"
                    press=".onNotificationItemPress"/>

            </List>
        </content>

        <beginButton>
            <Button
                id="clearAllNotifsBtn"
                text="Clear All"
                type="Transparent"
                press=".onClearAll"/>
        </beginButton>
        <endButton>
            <Button
                id="markAllReadNotifsBtn"
                text="Mark All as Read"
                type="Transparent"
                press=".onMarkAllRead"/>
        </endButton>

    </ResponsivePopover>

</core:FragmentDefinition>
