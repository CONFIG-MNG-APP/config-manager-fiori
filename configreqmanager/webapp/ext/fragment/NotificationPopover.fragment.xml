<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <ResponsivePopover
        id="notificationPopover"
        title="Thông báo ({notification>/unreadCount} chưa đọc)"
        placement="Bottom"
        contentWidth="400px"
        contentHeight="380px">

        <content>
            <List
                id="notifList"
                items="{notification>/notifications}"
                noDataText="Không có thông báo mới"
                mode="None">

                <StandardListItem
                    id="notifListItem"
                    title="{notification>title}"
                    description="{notification>description}"
                    info="{notification>timeDisplay}"
                    infoState="Warning"
                    type="Active"
                    highlight="{= ${notification>read} ? 'None' : 'Information' }"
                    press=".onNotificationItemPress"/>

            </List>
        </content>

        <beginButton>
            <Button
                id="clearAllNotifsBtn"
                text="Xóa tất cả"
                type="Transparent"
                press=".onClearAll"/>
        </beginButton>
        <endButton>
            <Button
                id="markAllReadNotifsBtn"
                text="Đánh dấu tất cả đã đọc"
                type="Transparent"
                press=".onMarkAllRead"/>
        </endButton>

    </ResponsivePopover>

</core:FragmentDefinition>
