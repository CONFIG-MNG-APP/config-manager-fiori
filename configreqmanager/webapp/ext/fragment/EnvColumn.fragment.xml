<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <ObjectStatus
        text="{EnvId}"
        state="{= ${path: 'EnvId', targetType: 'any'} === 'PRD' ? 'Error' : ${path: 'EnvId', targetType: 'any'} === 'QAS' ? 'Warning' : 'Success' }"
        class="cr-badge cr-badge-env"
        inverted="true" />
</core:FragmentDefinition>
